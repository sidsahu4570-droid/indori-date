# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=indori-date.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=indori-date
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=indori-date.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Razorpay Configuration (For In-App Purchases / Memberships)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
EXPO_PUBLIC_PAYMENT_API_URL=https://api.indoridate.com/payments

# Admin Setup
EXPO_PUBLIC_ADMIN_EMAIL=admin@indoridate.com
